    "Sign in with Google to view your AdMob revenue across all apps and ad units." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "value" : "Přihlaste se pomocí Google, abyste viděli své výdělky AdMob napříč všemi aplikacemi a reklamními jednotkami.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijunkite su Google, kad galėtumėte peržiūrėti savo AdMob pajamas visose programose ir skelbimų vienetuose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアプリと広告ユニットのAdMob収益を表示するにはGoogleでサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱 및 광고 단위에서 AdMob 수익을 보려면 Google로 로그인하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول باستخدام Google لعرض إيرادات AdMob الخاصة بك عبر جميع التطبيقات ووحدات الإعلانات."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan Google untuk melihat pendapatan AdMob Anda di semua aplikasi dan unit iklan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg inn med Google for å se AdMob-inntektene dine på tvers av alle apper og annonseenheter."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bejelentkezés Google-lal, hogy megtekinthesd az AdMob bevételedet az összes alkalmazásban és hirdetési egységben."
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Барлық қосымшалар мен жарнама бірліктері бойынша AdMob табысыңызды көру үшін Google арқылы кіріңіз.",
            "state" : "translated"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
